# Database
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/devgram

# Server (Railway sets PORT automatically)
PORT=4100
NODE_ENV=production

# CORS: Comma-separated list of allowed frontend origins
# Required for production so the deployed frontend can call this API.
ALLOWED_ORIGINS=https://www.devfinderapp.com,https://devfinderapp.com

# Auth
JWT_SECRET=your-long-random-jwt-secret

# Razorpay (payments)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
